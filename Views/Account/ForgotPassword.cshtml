@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="auth-wrap auth-visual swap-auth auth-clean-page">
    <div class="auth-photo-panel">
        <img src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1200&q=80" alt="Clean desk workspace" />
        <div>
            <span>Account recovery</span>
            <h2 class="serif">Get back into your dashboard with a reset link.</h2>
            <p>The link opens a secure form where you can set a fresh password.</p>
        </div>
    </div>
    <form class="auth-card" asp-action="ForgotPassword" method="post">
        <h1 class="serif">Reset password</h1>
        <p>Enter the email connected to your StallBazar account.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Email"></label>
        <input class="form-control" asp-for="Email" placeholder="name@example.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <button class="bp w-100" type="submit">Send reset link</button>
        <a asp-action="Login">Back to login</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
