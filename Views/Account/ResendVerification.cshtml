@model ResendVerificationViewModel
@{
    ViewData["Title"] = "Resend verification";
}

<section class="auth-wrap auth-visual swap-auth auth-clean-page">
    <div class="auth-photo-panel">
        <img src="https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=1200&q=80" alt="Conference event audience" />
        <div>
            <span>Verify email</span>
            <h2 class="serif">Request a fresh verification link before signing in.</h2>
            <p>Verified email accounts keep organizers, vendors, and booking updates trustworthy.</p>
        </div>
    </div>
    <form class="auth-card" asp-action="ResendVerification" method="post">
        <h1 class="serif">Verify email</h1>
        <p>Enter the email address you used during registration. A fresh verification link will be sent if the account exists.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Email"></label>
        <input class="form-control" asp-for="Email" placeholder="name@example.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <button class="bp w-100" type="submit">Send verification</button>
        <a asp-action="Login">Back to login</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
