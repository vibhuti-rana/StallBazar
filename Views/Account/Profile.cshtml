@model ProfileSettingsViewModel
@{
    ViewData["Title"] = "Profile";
}

<section class="page-shell swap-page profile-page">
    <div class="image-swipe-banner compact-banner" data-carousel>
        <div class="photo-slide active" style="background-image:url('https://images.unsplash.com/photo-1528605248644-14dd04022da1?auto=format&fit=crop&w=1400&q=80')"></div>
        <div class="photo-slide" style="background-image:url('https://images.unsplash.com/photo-1528698827591-e19ccd7bc23d?auto=format&fit=crop&w=1400&q=80')"></div>
        <div class="photo-slide" style="background-image:url('https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1400&q=80')"></div>
        <div class="banner-copy">
            <span>Your identity</span>
            <h2 class="serif">Make your vendor or organizer profile feel complete.</h2>
        </div>
    </div>
    <div class="page-head">
        <div>
            <div class="sec-lbl">Public profile</div>
            <h1 class="serif">Profile details</h1>
            <p>Keep your business identity, contact details, and profile photo clear for organizers and vendors.</p>
        </div>
        <a class="bo" asp-action="Settings">Account settings</a>
    </div>
    <div class="split-grid profile-layout">
        <form class="panel form-panel" asp-action="Profile" method="post" enctype="multipart/form-data">
            <h2>Edit profile</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="profile-editor">
                <img src="@(string.IsNullOrWhiteSpace(Model.ExistingProfileImageUrl) ? "/images/avatar-placeholder.svg" : Model.ExistingProfileImageUrl)" alt="Current profile photo" />
                <div>
                    <label asp-for="ProfileImage"></label>
                    <input class="form-control" asp-for="ProfileImage" type="file" accept="image/png,image/jpeg,image/webp" />
                </div>
            </div>
            <div class="field-grid">
                <div class="field">
                    <label asp-for="FullName"></label>
                    <input class="form-control" asp-for="FullName" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input class="form-control" asp-for="Email" placeholder="name@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="PhoneNumber"></label>
                    <input class="form-control" asp-for="PhoneNumber" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="City"></label>
                    <input class="form-control" asp-for="City" placeholder="Kathmandu" />
                </div>
                <div class="field full">
                    <label asp-for="BusinessName"></label>
                    <input class="form-control" asp-for="BusinessName" placeholder="Your stall, company, or organizer brand" />
                </div>
                <div class="field full">
                    <label asp-for="Bio"></label>
                    <textarea class="form-control" asp-for="Bio" rows="4" placeholder="Food type, products, audience, organizer experience, or vendor details"></textarea>
                </div>
            </div>
            <button class="bp" type="submit">Save profile</button>
        </form>
        <aside class="profile-preview">
            <div class="profile-photo-large" style="background-image:url('@(string.IsNullOrWhiteSpace(Model.ExistingProfileImageUrl) ? "https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=900&q=80" : Model.ExistingProfileImageUrl)')"></div>
            <div class="panel">
                <h2>@Model.FullName</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.BusinessName) ? "Add your stall, shop, or organizer brand." : Model.BusinessName)</p>
                <div class="profile-meta">
                    <span>@(string.IsNullOrWhiteSpace(Model.City) ? "City not added" : Model.City)</span>
                    <span>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Phone not added" : Model.PhoneNumber)</span>
                </div>
                <p class="muted mb-0">@(string.IsNullOrWhiteSpace(Model.Bio) ? "Add a short bio so people understand what you sell, organize, or need." : Model.Bio)</p>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
