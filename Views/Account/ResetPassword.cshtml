@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="auth-wrap auth-visual swap-auth auth-clean-page">
    <div class="auth-photo-panel">
        <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80" alt="Person working on a laptop" />
        <div>
            <span>Secure access</span>
            <h2 class="serif">Create a new password</h2>
            <p>Use a strong password before returning to your dashboard.</p>
        </div>
    </div>
    <form class="auth-card" asp-action="ResetPassword" method="post">
        <h1 class="serif">Reset password</h1>
        <p>Enter a new password for your StallBazar account.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <label asp-for="Password"></label>
        <div class="password-field"><input class="form-control" asp-for="Password" type="password" data-password-input /><button type="button" data-password-toggle>Show</button></div>
        <span asp-validation-for="Password" class="text-danger"></span>
        <label asp-for="ConfirmPassword"></label>
        <div class="password-field"><input class="form-control" asp-for="ConfirmPassword" type="password" data-password-input /><button type="button" data-password-toggle>Show</button></div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        <button class="bp w-100" type="submit">Update password</button>
        <a asp-action="Login">Back to login</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
