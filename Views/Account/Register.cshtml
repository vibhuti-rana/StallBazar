@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-wrap auth-visual swap-auth auth-clean-page">
    <div class="auth-photo-panel">
        <img src="https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=80" alt="Event hall with people networking" />
        <div>
            <span>Start quickly</span>
            <h2 class="serif">Create a vendor or organizer account for modern event stall work.</h2>
            <p>Use clear profiles, visual maps, and request tracking from day one.</p>
        </div>
    </div>
    <form class="auth-card" asp-action="Register" method="post">
        <h1 class="serif">Create account</h1>
        <p>Choose the role that matches how you will use StallBazar. Only verified Gmail accounts can sign in.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="FullName"></label>
        <input class="form-control" asp-for="FullName" />
        <span asp-validation-for="FullName" class="text-danger"></span>
        <label asp-for="Email"></label>
        <input class="form-control" asp-for="Email" placeholder="name@gmail.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <label asp-for="Password"></label>
        <div class="password-field"><input class="form-control" asp-for="Password" type="password" data-password-input /><button type="button" data-password-toggle>Show</button></div>
        <span asp-validation-for="Password" class="text-danger"></span>
        <label asp-for="ConfirmPassword"></label>
        <div class="password-field"><input class="form-control" asp-for="ConfirmPassword" type="password" data-password-input /><button type="button" data-password-toggle>Show</button></div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        <label asp-for="Role"></label>
        <select class="form-select" asp-for="Role">
            <option value="Vendor">Vendor</option>
            <option value="Organizer">Organizer</option>
        </select>
        <button class="bp w-100" type="submit">Create account</button>
        <a asp-action="Login">Already registered?</a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
