<!DOCTYPE html>
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
    ApplicationUser? navUser = null;
    var unreadNotifications = 0;
    var notificationPreview = new List<Notification>();
    if (User.Identity?.IsAuthenticated == true)
    {
        navUser = await UserManager.GetUserAsync(User);
        if (navUser is not null)
        {
            unreadNotifications = await DbContext.Notifications.CountAsync(n => n.UserId == navUser.Id && !n.IsRead);
            notificationPreview = await DbContext.Notifications
                .Where(n => n.UserId == navUser.Id)
                .OrderByDescending(n => n.CreatedAt)
                .Take(5)
                .ToListAsync();
        }
    }
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StallBazar</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StallBazar.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
</head>
<body class="site-body">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <header class="site-header" data-site-header>
        <nav class="navbar navbar-expand-lg sb-nav">
            <div class="container-fluid px-4">
                <a class="sb-logo" asp-controller="Home" asp-action="Index">Stall<span>Bazar</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(SeedData.VendorRole))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Vendor">Vendor Home</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Browse Events</a></li>
                                <li class="nav-item nav-search">
                                    <form asp-controller="Events" asp-action="Index" method="get">
                                        <input name="q" value="@ViewData["EventSearch"]" placeholder="Search events" aria-label="Search events" />
                                    </form>
                                </li>
                            }
                            else if (User.IsInRole(SeedData.OrganizerRole))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Organizer">Organizer Home</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Create">Create Event</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">All Events</a></li>
                            }
                            else if (User.IsInRole(SeedData.AdminRole))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Admin">Admin Home</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                            }
                            <li class="nav-item notification-nav-item">
                                <div class="notification-menu">
                                    <a class="nav-icon-btn nav-bell" asp-controller="Notifications" asp-action="Index" title="Notifications" aria-label="Notifications">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 7h18s-3 0-3-7"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                                        @if (unreadNotifications > 0) { <span>@unreadNotifications</span> }
                                    </a>
                                    <div class="notification-popover" role="menu" aria-label="Notification preview">
                                        <div class="notification-popover-head">
                                            <strong>Notifications</strong>
                                            <span>@unreadNotifications unread</span>
                                        </div>
                                        @if (notificationPreview.Any())
                                        {
                                            <div class="notification-preview-list">
                                                @foreach (var notification in notificationPreview)
                                                {
                                                    var localCreatedAt = notification.CreatedAt.ToLocalTime();
                                                    var timeLabel = localCreatedAt.Date == DateTime.Today
                                                        ? localCreatedAt.ToString("h:mm tt")
                                                        : localCreatedAt.ToString("MMM d, h:mm tt");
                                                    <a class="notification-preview-item @(notification.IsRead ? "" : "unread")" href="@(string.IsNullOrWhiteSpace(notification.LinkUrl) ? Url.Action("Index", "Notifications") : notification.LinkUrl)">
                                                        <span aria-hidden="true"></span>
                                                        <div>
                                                            <strong>@notification.Title</strong>
                                                            <p>@notification.Message</p>
                                                            <small>@timeLabel</small>
                                                        </div>
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="notification-preview-empty">No updates yet.</div>
                                        }
                                        <a class="notification-popover-link" asp-controller="Notifications" asp-action="Index">View all notifications</a>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-icon-btn" asp-controller="Account" asp-action="Settings" title="Settings" aria-label="Settings">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"></path><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.31.4.84.6 1.35.6H21a2 2 0 1 1 0 4h-.09A1.7 1.7 0 0 0 19.4 15Z"></path></svg>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-profile" asp-controller="Account" asp-action="Profile" title="Profile">
                                    <img src="@(string.IsNullOrWhiteSpace(navUser?.ProfileImageUrl) ? "/images/avatar-placeholder.svg" : navUser.ProfileImageUrl)" alt="@navUser?.FullName profile photo" />
                                    <span>@navUser?.FullName</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="nav-link nav-button" type="submit">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Browse Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">How it works</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">For Organizers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Support</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="ncta" asp-controller="Account" asp-action="Register">Sign up</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" role="main" tabindex="-1">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show auto-dismiss" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container mt-3"><div class="alert alert-danger alert-dismissible fade show auto-dismiss" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div></div>
        }
        @RenderBody()
    </main>

    <footer class="sb-footer">
        <div class="footer-brand">
            <div class="fl">Stall<span>Bazar</span></div>
            <p>A practical stall booking system for event organizers and vendors, with event listings, visual layouts, approvals, payments, and notifications in one place.</p>
        </div>
        <div class="footer-links footer-columns">
            <div>
                <strong>Products</strong>
                <a asp-controller="Events" asp-action="Index">Event discovery</a>
                <a asp-controller="Events" asp-action="Index">Stall booking</a>
                <a asp-controller="Account" asp-action="Register">Vendor onboarding</a>
            </div>
            <div>
                <strong>Industries</strong>
                <a asp-controller="Events" asp-action="Index">Food festivals</a>
                <a asp-controller="Events" asp-action="Index">Trade expos</a>
                <a asp-controller="Events" asp-action="Index">Community bazaars</a>
            </div>
            <div>
                <strong>Company</strong>
                <a asp-controller="Home" asp-action="About">About us</a>
                <a asp-controller="Home" asp-action="Contact">Contact us</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <div>
                <strong>Account</strong>
                <a asp-controller="Account" asp-action="Login">Organizer sign in</a>
                <a asp-controller="Account" asp-action="Login">Vendor sign in</a>
                <a asp-controller="Account" asp-action="Register">Create account</a>
            </div>
        </div>
        <div class="fr">&copy; 2026 StallBazar &middot; Clear event operations for organizers and vendors.</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
