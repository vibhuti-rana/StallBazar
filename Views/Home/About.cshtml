@{
    ViewData["Title"] = "About us";
}

<section class="info-hero swap-subhero" style="background-image:url('https://images.unsplash.com/photo-1528698827591-e19ccd7bc23d?auto=format&fit=crop&w=1800&q=80')">
    <div>
        <span>About StallBazar</span>
        <h1 class="serif">A clearer way to plan events and book stalls.</h1>
        <p>StallBazar helps organizers publish complete event pages with photos, map layouts, stall pricing, and approval workflows. Vendors can browse events, compare locations, request stalls, and track booking status without confusion.</p>
    </div>
</section>

<section class="page-shell swap-page info-page about-page">
    <div class="image-swipe-banner" data-carousel>
        <div class="photo-slide active" style="background-image:url('https://images.unsplash.com/photo-1528698827591-e19ccd7bc23d?auto=format&fit=crop&w=1400&q=80')"></div>
        <div class="photo-slide" style="background-image:url('https://images.unsplash.com/photo-1532635241-17e820acc59f?auto=format&fit=crop&w=1400&q=80')"></div>
        <div class="photo-slide" style="background-image:url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1400&q=80')"></div>
        <div class="banner-copy">
            <span>Built around real event flow</span>
            <h2 class="serif">From event setup to stall day, everything stays visible.</h2>
        </div>
    </div>
    <div class="split-grid">
        <article class="panel image-panel">
            <img src="https://images.unsplash.com/photo-1485217988980-11786ced9454?auto=format&fit=crop&w=900&q=80" alt="Vendor preparing a market stall" />
            <h2>For vendors</h2>
            <p>Find food events, fashion bazaars, book fairs, exhibitions, cultural fairs, and community markets. Review the event details, venue, stall map, price, deposit, and booking status before making a request.</p>
        </article>
        <article class="panel image-panel">
            <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=900&q=80" alt="Organizer planning workspace" />
            <h2>For organizers</h2>
            <p>Create event pages, upload your own photos and map layout images, add stall names and tiers, set pricing by stall size, and manage vendor booking approvals from one dashboard.</p>
        </article>
    </div>
    <div class="category-showcase mt-3">
        <article><span>Visual maps</span><p>Upload the exact venue layout and place stalls by row and column.</p></article>
        <article><span>Clear pricing</span><p>Separate standard, premium, and normal stalls with dimensions and prices.</p></article>
        <article><span>Status tracking</span><p>Vendors see pending, approved, rejected, booked, and unavailable updates.</p></article>
        <article><span>Better discovery</span><p>Categories, photos, and search help vendors find the right event faster.</p></article>
    </div>
</section>
