@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-shell narrow swap-page privacy-page">
    <div class="page-head editorial-head">
        <div>
            <div class="sec-lbl">Privacy</div>
            <h1 class="serif">Clear data practices for event booking.</h1>
            <p>StallBazar stores only the details needed to manage accounts, events, stalls, bookings, notifications, and payment references inside the platform.</p>
        </div>
    </div>
    <div class="panel story-panel">
        <h2>What the platform uses</h2>
        <div class="benefit-loop compact">
            <article><h3>Account data</h3><p>Name, email, role, phone, business profile, and verification state.</p></article>
            <article><h3>Event data</h3><p>Event names, venue details, dates, descriptions, categories, and uploaded images.</p></article>
            <article><h3>Booking data</h3><p>Stall requests, payment references, statuses, organizer notes, and timestamps.</p></article>
            <article><h3>Notifications</h3><p>System messages that help vendors and organizers follow booking activity.</p></article>
        </div>
    </div>
</section>
